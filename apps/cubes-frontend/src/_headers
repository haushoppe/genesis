# Cloudflare Pages headers.
#
# The cube preview renders inside a srcdoc iframe (origin "null"), and the
# on-chain cube renderer uploads each side as a WebGL texture, a cross-origin
# read that requires CORS. Real sides come from ordinals.com, which sends
# `Access-Control-Allow-Origin: *`. The preview-fallback side art
# (`/assets/…side.svg`, shown while a side is empty) is served from here, so
# it needs the same header or the texture upload is blocked and the face 404s
# in the console.
/assets/*
  Access-Control-Allow-Origin: *
