{
  "name": "cubes-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "HAUS HOPPE — Ordinal Cubes frontend (cubes.haushoppe.art). Permissionless 3D Bitcoin cube gallery.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prestart:regtest": "node scripts/ensure-regtest-inscriptions.mjs && node scripts/write-regtest-stack.mjs",
    "start:regtest": "ng serve -c regtest",
    "prebuild": "node scripts/ensure-regtest-inscriptions.mjs && node scripts/write-regtest-stack.mjs && node scripts/inject-env.mjs",
    "build": "ng build",
    "lint": "eslint 'src/**/*.ts' --max-warnings 0",
    "e2e:regtest": "playwright test --config e2e/regtest/playwright.config.ts",
    "e2e:regtest:up": "bash e2e/regtest/regtest-bootstrap.sh",
    "e2e:regtest:run": "node node_modules/ordpool-sdk/scripts/e2e-slots.mjs run --kind regtest --label cubes-e2e -- bash -c 'bash e2e/regtest/regtest-bootstrap.sh >/dev/null && npm run e2e:regtest -- \"$@\"' cubes-e2e-run",
    "e2e:regtest:down": "node node_modules/ordpool-sdk/scripts/e2e-slots.mjs down \"${E2E_SLOT:?set E2E_SLOT to the slot the stack holds, see e2e:slots}\"",
    "e2e:slots": "node node_modules/ordpool-sdk/scripts/e2e-slots.mjs",
    "pretest": "node scripts/ensure-regtest-inscriptions.mjs && node scripts/write-regtest-stack.mjs",
    "test": "ng test",
    "pretest:vitest": "node scripts/ensure-regtest-inscriptions.mjs && node scripts/write-regtest-stack.mjs",
    "test:vitest": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.e2e.json",
    "pretypecheck": "node scripts/ensure-regtest-inscriptions.mjs && node scripts/write-regtest-stack.mjs",
    "dupes": "jscpd"
  },
  "dependencies": {
    "@angular/animations": "22.0.6",
    "@angular/common": "22.0.6",
    "@angular/compiler": "22.0.6",
    "@angular/core": "22.0.6",
    "@angular/forms": "22.0.6",
    "@angular/localize": "22.0.6",
    "@angular/platform-browser": "22.0.6",
    "@angular/platform-browser-dynamic": "22.0.6",
    "@angular/router": "22.0.6",
    "@fontsource/inter": "^5.0.8",
    "@fontsource/merriweather": "^4.5.14",
    "@fontsource/yantramanav": "^4.5.9",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@noble/curves": "^1.4.0",
    "@popperjs/core": "^2.11.8",
    "@scure/base": "^1.1.0",
    "@scure/btc-signer": "1.6.0",
    "angularx-qrcode": "^21.0.5",
    "bignumber.js": "^9.1.2",
    "bitcoin-address-validation": "^2.2.1",
    "bootstrap": "^5.3.1",
    "bootstrap-icons": "^1.10.5",
    "buffer": "^6.0.3",
    "canvas-confetti": "^1.6.0",
    "ordpool-sdk": "github:ordpool-space/ordpool-sdk#8de8536967a731a3e924b11a922d3c2defd547a7",
    "process": "^0.11.10",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~7.8.0",
    "sats-connect": "^4.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.0.6",
    "@angular/cli": "22.0.6",
    "@angular/compiler-cli": "22.0.6",
    "@playwright/test": "^1.61.0",
    "@types/canvas-confetti": "^1.6.0",
    "@types/node": "^18.11.18",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "8.46.0",
    "jscpd": "^4.3.0",
    "jsdom": "^25.0.0",
    "typescript": "6.0.3",
    "vitest": "^3.0.0"
  }
}
